# ============================================================
# AlgoAnalyzer — environment configuration (copy to .env)
# ============================================================

# --- Backend (backend/.env) ---------------------------------
# SQLite for zero-config development; PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg://algo:algo@db:5432/algoanalyzer
DATABASE_URL=sqlite:///./algodata.db

# CORS origins (JSON list). A wildcard is safe here: no cookies are used.
CORS_ORIGINS=["*"]

# AI explanation layer: "heuristic" (offline, deterministic) or "openai".
AI_PROVIDER=heuristic
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Benchmark sandbox tuning.
BENCHMARK_ENABLED=true
BENCHMARK_TIMEOUT_SECONDS=30
BENCHMARK_MAX_MEMORY_MB=512
BENCHMARK_REPEATS=3

# --- Frontend (frontend/.env) -------------------------------
# Optional absolute backend origin; defaults to relative /api paths.
# VITE_API_BASE=http://localhost:8000
